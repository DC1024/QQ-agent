# 复制成 .env 后按需修改（.env 已被 .gitignore 忽略，不会进仓库）

# 控制台监听地址
#   127.0.0.1 = 只监听回环，远程访问必须走 SSH 隧道（默认，最安全）
#   0.0.0.0   = 监听所有网卡，局域网可直接访问
QQ_AGENT_HOST=127.0.0.1

# 可信 Host 白名单：逗号分隔，必须带端口，精确匹配，不支持通配
# 只有 QQ_AGENT_HOST=0.0.0.0 时才需要填，否则所有 /api/* 会返回 403
# 例：QQ_AGENT_ALLOWED_HOSTS=192.168.1.10:3210,qq-agent.lan:3210
QQ_AGENT_ALLOWED_HOSTS=

# 控制台端口
QQ_AGENT_PORT=3210
