# 仓库根目录的忽略规则（容器化层专属）
#
# ⚠️ 上游把项目搬进了 0.4/ 子目录，项目自身的忽略规则在 0.4/.gitignore。
#    这里只管根目录：Dockerfile / docker-compose.yml / .dockerignore 这一层，
#    以及本地跑 install 时可能落在根目录的依赖与数据。
#    少了这份文件，根目录的 node_modules 会被 git add -A 一起提交进去。

# 依赖（根目录与子项目各一份）
node_modules/
0.4/node_modules/

# 运行时数据：真实聊天记录、含 API Key 的 config.json
data/
data-2/

# NapCat 协议端数据（登录态 + 网络配置），等同账号凭据，绝不入库
data-napcat/
data-napcat-2/
napcat/
napcat2/

# 便携 QQ 运行时与临时产物
runtime/
snowluma/
tmp/
.trash/
dist/
release/

# 本地环境
.env
.env.local
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db
