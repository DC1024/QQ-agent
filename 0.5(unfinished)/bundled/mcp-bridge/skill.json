{
  "id": "mcp-bridge",
  "name": "MCP 桥接",
  "version": "0.5.0",
  "apiVersion": 1,
  "kind": "plugin",
  "category": "utility",
  "description": "通过受权限管控的 stdio MCP 客户端发现并调用外部工具。",
  "enabledByDefault": true,
  "permissions": ["proc.exec", "mcp.connect"],
  "configSchema": {
    "servers": { "type": "array", "items": { "type": "object" }, "description": "MCP server 配置数组" }
  },
  "settings": { "servers": [] },
  "entry": "index.js"
}
