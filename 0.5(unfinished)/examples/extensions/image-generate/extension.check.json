{
  "version": 1,
  "cases": [
    {
      "name": "生成真实格式的 PNG 后只通过受控发送接口发送一次",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "group:20001" },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 200, "request": { "headers": { "authorization": "Bearer test-image-key" }, "json": { "model": "test-image-model", "prompt": "a cat", "response_format": "b64_json" } }, "json": { "data": [{ "b64_json": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aCJkAAAAASUVORK5CYII=" }] } }],
      "expect": { "ok": true, "result": { "sent": true }, "sends": [{ "method": "sendImage", "chatKey": "group:20001" }], "sendCount": 1, "httpCount": 1 }
    },
    {
      "name": "当前聊天丢失时不生成也不猜测发送目标",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" } },
      "expect": { "ok": false, "errorIncludes": "需要当前聊天", "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "缺少密钥时在联网前拒绝",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "图片服务密钥", "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "未授权发送时不先产生付费生成请求",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "deny" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "权限", "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "图片服务 401 不回显原始正文和密钥",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 401, "json": { "error": "secret test-image-key expired" } }],
      "expect": { "ok": false, "errorIncludes": "HTTP 401", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "只有 URL 的响应不能当成 b64_json",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 200, "json": { "data": [{ "url": "https://images.example.test/example.png" }] } }],
      "expect": { "ok": false, "errorIncludes": "PNG base64", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "非 PNG 字节不能冒充图片",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 200, "json": { "data": [{ "b64_json": "bm90LWEtcG5nLWZpbGU=" }] } }],
      "expect": { "ok": false, "errorIncludes": "不是约定的 PNG", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "发送失败回执不能报告已经发送",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 200, "json": { "data": [{ "b64_json": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aCJkAAAAASUVORK5CYII=" }] } }],
      "sendResult": { "ok": false, "sent": [], "failed": [{ "error": "fixture-disconnected" }] },
      "expect": { "ok": false, "errorIncludes": "未获得图片发送成功回执", "sendCount": 1, "httpCount": 1 }
    },
    {
      "name": "去重回执明确报告没有新增发送",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 200, "json": { "data": [{ "b64_json": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aCJkAAAAASUVORK5CYII=" }] } }],
      "sendResult": { "ok": true, "sent": [], "failed": [], "deduped": true },
      "expect": { "ok": true, "result": { "sent": false, "deduped": true }, "sendCount": 1, "httpCount": 1 }
    },
    {
      "name": "空成功回执不被误认为确认发送",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 200, "json": { "data": [{ "b64_json": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aCJkAAAAASUVORK5CYII=" }] } }],
      "sendResult": { "ok": true, "sent": [], "failed": [] },
      "expect": { "ok": false, "errorIncludes": "回执不完整", "sendCount": 1, "httpCount": 1 }
    },
    {
      "name": "取消生成后不发送迟到图片",
      "config": { "endpoint": "https://images.example.test/v1/images/generations", "apiKey": "test-image-key", "model": "test-image-model" },
      "permissions": { "net.outbound": "allow", "qq.send": "allow" },
      "input": { "tool": "draw", "args": { "prompt": "a cat" }, "chatKey": "private:10001", "cancelAfterMs": 10 },
      "http": [{ "url": "https://images.example.test/v1/images/generations", "method": "POST", "status": 200, "responseDelayMs": 200, "json": { "data": [{ "b64_json": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aCJkAAAAASUVORK5CYII=" }] } }],
      "expect": { "ok": false, "errorIncludes": "取消", "sendCount": 0, "httpCount": 1 }
    }
  ]
}
