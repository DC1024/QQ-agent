{
  "id": "example-image-generate",
  "name": "范例：文生图并发送到当前聊天",
  "version": "1.0.0",
  "kind": "skill",
  "apiVersion": 1,
  "entry": "index.js",
  "enabledByDefault": false,
  "category": "media",
  "description": "原生 v0.5 技能：调用自己的图片服务、验证 PNG、受控发送并检查回执。",
  "author": "QQ Agent examples",
  "permissions": ["net.outbound", "qq.send"],
  "settings": { "endpoint": "", "apiKey": "", "model": "", "timeoutMs": 20000 },
  "configSchema": {
    "endpoint": { "type": "string", "label": "完整 HTTPS 图片生成地址", "placeholder": "https://your-service.example/v1/images/generations" },
    "apiKey": { "type": "string", "label": "图片服务密钥", "secret": true },
    "model": { "type": "string", "label": "服务支持的模型 ID" },
    "timeoutMs": { "type": "integer", "label": "请求超时（毫秒）", "minimum": 1000, "maximum": 20000 }
  },
  "prompt": {
    "sections": [{ "id": "usage", "title": "文生图", "priority": 30, "content": "用户明确要生成图片时调用 example-image-generate__draw。工具会把图片直接发送到当前聊天，成功后不要再调用 send_message 重复说明图片已发送。失败时只说明工具返回的实际原因；取消、未确认或去重不能说新图片已发送。不要自动重试可能已经发送的请求。" }]
  }
}
