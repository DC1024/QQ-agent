{
  "id": "example-roll-dice",
  "name": "范例：掷骰子",
  "version": "1.0.0",
  "kind": "skill",
  "apiVersion": 1,
  "entry": "index.js",
  "enabledByDefault": false,
  "category": "utility",
  "description": "原生 v0.5 技能：参数校验、配置和隔离的本地统计。",
  "author": "QQ Agent examples",
  "permissions": [],
  "settings": { "defaultSides": 6, "maxRolls": 10 },
  "configSchema": {
    "defaultSides": { "type": "integer", "label": "默认骰子面数", "minimum": 1, "maximum": 1000 },
    "maxRolls": { "type": "integer", "label": "每次最多骰子数", "minimum": 1, "maximum": 20 }
  },
  "prompt": {
    "sections": [{ "id": "usage", "title": "掷骰子", "priority": 30, "content": "用户明确要掷骰子时调用 example-roll-dice__roll。工具只返回结果，由你用 send_message 回复；不要声称结果已经发送。" }]
  }
}
