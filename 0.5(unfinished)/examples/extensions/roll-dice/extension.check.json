{
  "version": 1,
  "cases": [
    {
      "name": "两次调用更新同一隔离命名空间中的统计",
      "inputs": [
        { "tool": "roll", "args": { "count": 2, "sides": 1 }, "chatKey": "private:10001" },
        { "tool": "roll", "args": { "count": 3, "sides": 1 }, "chatKey": "group:20001" }
      ],
      "expect": {
        "ok": true,
        "results": [
          { "ok": true, "result": { "rolls": [1, 1], "total": 2, "rollCount": 1 } },
          { "ok": true, "result": { "rolls": [1, 1, 1], "total": 3, "rollCount": 2 } }
        ],
        "storage": { "stats": { "rollCount": 2, "diceCount": 5, "lastTotal": 3 } },
        "sendCount": 0, "httpCount": 0
      }
    },
    {
      "name": "运行时读取用户配置中的默认面数",
      "config": { "defaultSides": 1, "maxRolls": 2 },
      "input": { "tool": "roll", "args": { "count": 2 }, "chatKey": "private:10001" },
      "expect": { "ok": true, "result": { "rolls": [1, 1], "total": 2 }, "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "配置中的骰子数上限由 handler 再次校验",
      "config": { "maxRolls": 2 },
      "input": { "tool": "roll", "args": { "count": 3 }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "骰子数须为 1 到 2 的整数", "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "宿主参数校验拒绝错误类型",
      "input": { "tool": "roll", "args": { "count": "2" }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "参数类型错误", "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "宿主参数校验拒绝未知参数",
      "input": { "tool": "roll", "args": { "sides": 6, "unknown": true }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "未知参数", "sendCount": 0, "httpCount": 0 }
    }
  ]
}
