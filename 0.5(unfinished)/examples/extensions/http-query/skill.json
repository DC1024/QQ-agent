{
  "id": "example-http-query",
  "name": "范例：查询自己的 HTTP 服务",
  "version": "1.0.0",
  "kind": "skill",
  "apiVersion": 1,
  "entry": "index.js",
  "enabledByDefault": false,
  "category": "utility",
  "description": "原生 v0.5 技能：带密钥的 HTTP JSON 查询、取消和安全错误。",
  "author": "QQ Agent examples",
  "permissions": ["net.outbound"],
  "settings": { "endpoint": "", "token": "", "timeoutMs": 15000 },
  "configSchema": {
    "endpoint": { "type": "string", "label": "完整 HTTPS 查询地址", "placeholder": "https://your-service.example/query" },
    "token": { "type": "string", "label": "服务令牌（可选）", "secret": true },
    "timeoutMs": { "type": "integer", "label": "请求超时（毫秒）", "minimum": 1000, "maximum": 20000 }
  },
  "prompt": {
    "sections": [{ "id": "usage", "title": "自己的查询服务", "priority": 30, "content": "用户需要查询已配置的服务时调用 example-http-query__query。工具返回文本，由你用 send_message 回复；不要声称工具已替你发送。服务用途以用户配置为准。" }]
  }
}
