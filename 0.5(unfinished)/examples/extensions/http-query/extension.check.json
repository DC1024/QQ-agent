{
  "version": 1,
  "cases": [
    {
      "name": "配置令牌通过请求头发送，结果只返回 answer 文本",
      "config": { "endpoint": "https://api.example.test/query", "token": "test-token" },
      "permissions": { "net.outbound": "allow" },
      "input": { "tool": "query", "args": { "query": "cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://api.example.test/query", "method": "POST", "status": 200, "request": { "headers": { "authorization": "Bearer test-token", "content-type": "application/json" }, "json": { "query": "cat" } }, "json": { "answer": "找到 3 条猫咪记录", "privateDebug": "不应返回的服务内部数据" } }],
      "expect": { "ok": true, "result": "找到 3 条猫咪记录", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "未配置地址时给出可操作的错误",
      "permissions": { "net.outbound": "allow" },
      "input": { "tool": "query", "args": { "query": "cat" }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "请先配置完整的 HTTPS 查询地址", "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "未授权网络时不发请求",
      "config": { "endpoint": "https://api.example.test/query", "token": "test-token" },
      "permissions": { "net.outbound": "deny" },
      "input": { "tool": "query", "args": { "query": "cat" }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "权限", "sendCount": 0, "httpCount": 0 }
    },
    {
      "name": "401 不回显服务响应或令牌",
      "config": { "endpoint": "https://api.example.test/query", "token": "test-token" },
      "permissions": { "net.outbound": "allow" },
      "input": { "tool": "query", "args": { "query": "cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://api.example.test/query", "method": "POST", "status": 401, "json": { "error": "token test-token expired" } }],
      "expect": { "ok": false, "errorIncludes": "HTTP 401", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "服务返回错误结构时不把对象假装成文本",
      "config": { "endpoint": "https://api.example.test/query" },
      "permissions": { "net.outbound": "allow" },
      "input": { "tool": "query", "args": { "query": "cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://api.example.test/query", "method": "POST", "status": 200, "json": { "answer": { "nested": "wrong" } } }],
      "expect": { "ok": false, "errorIncludes": "answer 文本", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "非 JSON 响应提供明确错误",
      "config": { "endpoint": "https://api.example.test/query" },
      "permissions": { "net.outbound": "allow" },
      "input": { "tool": "query", "args": { "query": "cat" }, "chatKey": "private:10001" },
      "http": [{ "url": "https://api.example.test/query", "method": "POST", "status": 200, "bodyBase64": "bm90LWpzb24=" }],
      "expect": { "ok": false, "errorIncludes": "有效 JSON", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "取消慢请求后没有结果也不发送消息",
      "config": { "endpoint": "https://api.example.test/query" },
      "permissions": { "net.outbound": "allow" },
      "input": { "tool": "query", "args": { "query": "cat" }, "chatKey": "private:10001", "cancelAfterMs": 10 },
      "http": [{ "url": "https://api.example.test/query", "method": "POST", "status": 200, "responseDelayMs": 200, "json": { "answer": "迟到的结果" } }],
      "expect": { "ok": false, "errorIncludes": "取消", "sendCount": 0, "httpCount": 1 }
    },
    {
      "name": "空白查询在联网前被拒绝",
      "config": { "endpoint": "https://api.example.test/query" },
      "permissions": { "net.outbound": "allow" },
      "input": { "tool": "query", "args": { "query": "   " }, "chatKey": "private:10001" },
      "expect": { "ok": false, "errorIncludes": "非空文本", "sendCount": 0, "httpCount": 0 }
    }
  ]
}
