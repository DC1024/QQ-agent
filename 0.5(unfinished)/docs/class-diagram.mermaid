classDiagram
  class ConsoleRoutes {
    +register(http, deps)
    +status()
    +configGet()
    +configPatch(patch)
    +sessionList(limit)
    +sessionGet(id)
    +sessionDelete(id)
    +chatList()
    +chatMessages(key, limit)
    +chatControl(key, operation, body)
    +skillList(kind)
    +skillPatch(id, body)
  }
  class PanelProtocol {
    +validateRequest(request, source, origin)
    +handle(request, context)
    +makeResponse(id, result)
    +makeError(id, code, message, data)
  }
  class SseBridge {
    +subscribe(bus)
    +broadcast(event, payload)
    +snapshot()
    +close()
  }
  class PanelRegistry {
    +register(definition)
    +mount(id)
    +unmount(id)
    +routeMessage(event)
  }
  class ApiClient {
    +request(method, path, params)
    +get(path, query)
    +post(path, body)
  }
  class StateStore {
    +set(patch)
    +get()
    +subscribe(listener)
    +unsubscribe(listener)
  }
  class Config {
    +load()
    +get()
    +update(patch)
    +onChange(listener)
  }
  class ChatStore {
    +listChats()
    +recent(chatKey, limit)
    +markAllRead(chatKey)
    +clearChat(chatKey)
    +removeByLocalIds(chatKey, ids)
  }
  class SessionRegistry {
    +listSummaries(limit)
    +get(id)
    +finish(id, status)
    +delete(id)
  }
  class PluginLoader {
    +listEntries()
    +setEnabled(id, enabled)
    +loadAll(reason)
    +unload(id, reason)
  }
  class Orchestrator {
    +status()
    +pause()
    +resume()
    +retrySession(id)
    +abortSession(id)
  }
  class HttpServer {
    +route(method, pattern, handler)
    +listen()
    +broadcast(event, payload)
  }
  class PanelRequest {
    +string jsonrpc
    +string id
    +string method
    +object params
    +object meta
  }
  class PanelResponse {
    +string jsonrpc
    +string id
    +object result
    +object error
  }

  HttpServer --> ConsoleRoutes : dispatches
  ConsoleRoutes --> Config : reads/writes
  ConsoleRoutes --> ChatStore : archive operations
  ConsoleRoutes --> SessionRegistry : session operations
  ConsoleRoutes --> PluginLoader : module operations
  ConsoleRoutes --> Orchestrator : runtime controls
  ConsoleRoutes --> SseBridge : event publication
  SseBridge --> HttpServer : SSE frames
  PanelRegistry --> PanelProtocol : validates/routs
  PanelProtocol --> ApiClient : proxies API requests
  PanelProtocol --> StateStore : state/event updates
  PanelProtocol --> PanelRequest : accepts
  PanelProtocol --> PanelResponse : returns
